&lt;td class="lntd">
&lt;pre tabindex="0" class="chroma">&lt;code class="language-text" data-lang="text">&lt;span class="line">&lt;span class="cl">project_root/
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> |-- webpack.config.js
&lt;/span>&lt;/span>&lt;span class="line">&lt;span class="cl"> |-- mockserver.js
